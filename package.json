{
  "name": "voiden-vault-secrets",
  "version": "1.0.0",
  "type": "module",
  "private": false,
  "description": "Resolve {{vault.*}} secrets from HashiCorp Vault at request time, so they never live in your project files",
  "main": "./src/plugin.ts",
  "scripts": {
    "build": "node build.mjs && node build-main.mjs",
    "build:main": "node build-main.mjs",
    "zip": "node zip.mjs",
    "release": "node build.mjs && node build-main.mjs && node generate-manifest.mjs",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@voiden/sdk": ">=1.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.2.0",
    "@voiden/sdk": "latest",
    "electron": "^33.4.11",
    "esbuild": "^0.20.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0",
    "vitest": "^1.6.0"
  },
  "author": "Phurpa Tsering",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/phurpa-tsering/voiden-vault-secrets.git"
  }
}
